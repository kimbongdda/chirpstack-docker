# MQTT 브로커 주소
# - 로컬 실행: 서버 IP 주소
# - Docker 실행: mosquitto (docker-compose 서비스명)
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# 구독 토픽 (둘 중 하나 선택)
# application/+/device/+/event/up  <- 디바이스 uplink 이벤트 (기본값)
# kr920/gateway/+/event/up          <- 게이트웨이 이벤트
SUB_TOPIC=application/+/device/+/event/up

# ChirpStack gRPC 서버 주소
# - 로컬 실행: 서버 IP 주소
# - Docker 실행: chirpstack (docker-compose 서비스명)
CHIRPSTACK_HOST=chirpstack
GRPC_PORT=8080

# API 토큰 (Tenant → API Keys 에서 발급)
API_TOKEN=여기에_Tenant_API_키_입력

# 관리자 API 토큰 (Network Server → API Keys 에서 발급)
ADMIN_API_TOKEN=여기에_Network_Server_API_키_입력

# 다운링크 설정
DOWNLINK_FPORT=10
DOWNLINK_CONFIRMED=False

# 이벤트 저장 개수
MAX_EVENTS=300
