# Ignore local secret files, but keep shareable templates.
.env
**/.env
!.env.example
!**/.env.example

# Keep Git metadata files and repo automation directories visible.
!.gitignore
!.gitattributes
!.github/

# Ignore local runtime data and backup artifacts.
/artifacts/
/data/
/lorawan-devices/
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
*.sql.gz
*.rdb
*.bak
*.log
